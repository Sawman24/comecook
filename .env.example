# ==========================================
# Cooked Production Environment Variables
# ==========================================

# Core Application Settings
COOKED_ENV=production
SECRET_KEY=generate_with_openssl_rand_hex_32
PORT=5050
HOST_PORT=8080
DOMAIN=comecook.net
APP_URL=https://comecook.net
SESSION_COOKIE_SECURE=1
COOKED_SEED_DEMO=0

# ==========================================
# Transactional Email (Gmail SMTP)
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=cooked.noreply@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_USE_TLS=1
SMTP_FROM_NAME=Cooked
SMTP_FROM_EMAIL=cooked.noreply@gmail.com

# ==============================================================================
# Cooked Platform - Environment Configuration Template
# Copy this file to '.env' on your production server: cp .env.example .env
# ==============================================================================

# Application Environment (production / development)
COOKED_ENV=production
FLASK_ENV=production

# Strong 64-character secret key for signing session tokens
# Generate with: openssl rand -hex 32
SECRET_KEY=replace_with_a_secure_random_64_char_hex_key

# Port to expose on host machine
PORT=5050

# Domain name for automatic HTTPS / TLS certificate generation via Caddy
# e.g. comecook.app
DOMAIN=comecook.app


# Force secure cookies (set to 1 when serving over HTTPS)
SESSION_COOKIE_SECURE=1

# Storage Paths inside container (defaults work out of the box)
COOKED_DB_PATH=/app/data/cooked.db
UPLOAD_FOLDER=/app/uploads

# Pre-defined admin usernames (comma-separated, optional)
# Note: The very first account registered on a fresh database automatically becomes Owner/Admin
ADMIN_USERNAMES=

# Demo Seed Data (0 = clean database for real users, 1 = populate sample recipes/chefs)
COOKED_SEED_DEMO=0
